# Copy this file to .env and fill in the values from your Postgres provider.
#
# For Netlify production, use a hosted Postgres provider connected to Netlify
# such as Neon. Put the provider's pooled Postgres URL in Netlify as DATABASE_URL.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require"

# API server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET="<set-a-32-plus-character-secret-from-your-secret-manager>"
APP_BASE_URL="http://localhost:5173"
API_BASE_URL="http://localhost:3000"

# Google sign-in. Create a Google OAuth web client and register this exact callback URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Transactional email for password reset and email verification.
# If RESEND_API_KEY is empty in development, email links are written to logs.
RESEND_API_KEY=""
EMAIL_FROM="CareerPath AI <noreply@careerpath.local>"

# Observability
SENTRY_DSN=""
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend dev server
BASE_PATH=/
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=""
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
