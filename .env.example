# API server
PORT=8080
DATABASE_URL=postgresql://restricted_runtime:change-me@127.0.0.1:5432/careerpathx
# Dedicated local taxonomy publication database only. Never point this at
# production or at another project's PostgreSQL instance.
CAREERPATHX_DATABASE_URL=postgresql://careerpathx:change-me@127.0.0.1:55432/careerpathx
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=http://localhost:21588
API_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to ${API_BASE_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Supabase client configuration, if the frontend starts using Supabase directly.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vite development proxy target.
API_ORIGIN=http://127.0.0.1:8080
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=provision-through-encrypted-server-secret-store
MIGRATION_DATABASE_URL=provision-through-encrypted-secret-store
WORKER_DATABASE_URL=provision-through-encrypted-secret-store
STAGING_DATABASE_URL=restricted-runtime-identity-for-hosted-tests
STAGING_WORKER_DATABASE_URL=restricted-worker-identity-for-hosted-tests
STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
