{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "dev:api": "sh ./scripts/dev-api-with-db-secret.sh",
    "dev:api:secret": "sh ./scripts/dev-api-with-db-secret.sh",
    "db:generate": "pnpm --filter @workspace/db exec drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate:test": "pnpm --filter @workspace/db exec drizzle-kit migrate --config ./drizzle.config.ts",
    "taxonomy": "pnpm --filter @workspace/scripts run taxonomy --",
    "taxonomy:source:prepare": "pnpm --filter @workspace/scripts run taxonomy:source:prepare --",
    "taxonomy:source:inspect": "pnpm --filter @workspace/scripts run taxonomy:source:inspect --",
    "taxonomy:source:validate": "pnpm --filter @workspace/scripts run taxonomy:source:validate --",
    "taxonomy:ingest": "pnpm --filter @workspace/scripts run taxonomy:ingest --",
    "taxonomy:reconcile": "pnpm --filter @workspace/scripts run taxonomy:reconcile --",
    "taxonomy:review-report": "pnpm --filter @workspace/scripts run taxonomy:review-report --",
    "taxonomy:generate-canonical": "pnpm --filter @workspace/scripts run taxonomy:generate-canonical --",
    "taxonomy:validate": "pnpm --filter @workspace/scripts run taxonomy:validate --",
    "taxonomy:import": "pnpm --filter @workspace/scripts run taxonomy:import --",
    "taxonomy:review": "pnpm --filter @workspace/scripts run taxonomy:review --",
    "taxonomy:review:summary": "pnpm --filter @workspace/scripts run taxonomy:review:summary --",
    "taxonomy:review:occupations": "pnpm --filter @workspace/scripts run taxonomy:review:occupations --",
    "taxonomy:review:skills": "pnpm --filter @workspace/scripts run taxonomy:review:skills --",
    "taxonomy:review:aliases": "pnpm --filter @workspace/scripts run taxonomy:review:aliases --",
    "taxonomy:review:relationships": "pnpm --filter @workspace/scripts run taxonomy:review:relationships --",
    "taxonomy:review:transitions": "pnpm --filter @workspace/scripts run taxonomy:review:transitions --",
    "taxonomy:governance:validate": "pnpm --filter @workspace/scripts run taxonomy:governance:validate --",
    "taxonomy:review:prepare": "pnpm --filter @workspace/scripts run taxonomy:review:prepare --",
    "taxonomy:review:progress": "pnpm --filter @workspace/scripts run taxonomy:review:progress --",
    "taxonomy:review:validate": "pnpm --filter @workspace/scripts run taxonomy:review:validate --",
    "taxonomy:review:apply": "pnpm --filter @workspace/scripts run taxonomy:review:apply --",
    "taxonomy:review:conflicts": "pnpm --filter @workspace/scripts run taxonomy:review:conflicts --",
    "taxonomy:review:readiness": "pnpm --filter @workspace/scripts run taxonomy:review:readiness --",
    "taxonomy:review:onboarding:prepare": "pnpm --filter @workspace/scripts run taxonomy:review:onboarding:prepare --",
    "taxonomy:review:onboarding:validate": "pnpm --filter @workspace/scripts run taxonomy:review:onboarding:validate --",
    "taxonomy:review:pilot:prepare": "pnpm --filter @workspace/scripts run taxonomy:review:pilot:prepare --",
    "taxonomy:review:pilot:status": "pnpm --filter @workspace/scripts run taxonomy:review:pilot:status --",
    "taxonomy:publish": "pnpm --filter @workspace/scripts run taxonomy:publish --",
    "test": "pnpm -r --if-present run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "pg": "^8.21.0"
  }
}
